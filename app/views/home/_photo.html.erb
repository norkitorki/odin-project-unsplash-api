<div class="photoContainer">
  <%= image_tag photo["urls"]["small"], alt: photo["alt_description"] %>

  <div class="photoActions">
    <%= link_to photo["links"]["html"], target: '_blank' do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <title>Open photo in new tab</title>
        <path d="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z" />
      </svg>
    <% end %>
    <%= link_to photo["links"]["download"] do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <title>Download photo</title>
        <path d="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z" />
      </svg>
    <% end %>
  </div>

  <%= link_to photo["user"]["links"]["html"], class: "userLink" do %>
    <%= image_tag photo["user"]["profile_image"]["small"] %>
    <%= photo["user"]["name"] %>
  <% end %>
</div>
